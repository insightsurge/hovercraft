  "branch": "tooltips-interim",
  "files": [
    "placeholders.json",
    "tip.json",
    "www/tip.css",
    "www/tip.js"
  ],
  "sha256": {
    "placeholders.json": "635d22fe2c0ecf1935d9dba3d1f811d75c5cfbcf1d99a6157bf9de990e3f88d2",
    "tip.json": "f4b0d4acb0a05059f6bf02c411d7c3c9ceca0effb4c60caa42dea81f9f083e02",
    "www/tip.css": "8348f7bf6c9d8353001620804663f591e2d45be5f722e92476d53503a1280aca",
    "www/tip.js": "67d8b885ee82c21233432c61dabb158b553278dc0f4e1c9f0e7fa4e37d25afe3"
  },
  "names": {
    "attribute": "data-hovercraft-tip",
    "css": "hc-tip",
    "global": "Hovercraft",
    "prefix": "hovercraft",
    "product": "hovercraft"
  },
  "rules": {
    "tooltip": {
      "support": {
        "field": "tooltip",
        "template_option": "tooltip_template",
        "pin_option": "tooltip_pin",
        "switch_option": "tooltip",
        "templates_option": "tooltip_templates",
        "placement_option": "tooltip_placement"
      },
      "placement": {
        "values": [
          "auto",
          "top",
          "bottom",
          "left",
          "right"
        ],
        "default": "auto"
      },
      "switch": {
        "rule": "nearest"
      },
      "template_names": {
        "rule": "names"
      },
      "engine_fields": [
        "tip_index",
        "tip_id"
      ],
      "placeholder": {
        "open": "{{",
        "close": "}}",
        "filter": "|",
        "arg": ":",
        "empty": "–"
      },
      "filters": {
        "number": {
          "arg": "integer",
          "arg_required": false,
          "arg_pattern": "^[0-9]+$",
          "min": 0,
          "max": 100
        },
        "percent": {
          "arg": "integer",
          "arg_required": false,
          "arg_pattern": "^[0-9]+$",
          "min": 0,
          "max": 100
        }
      },
      "filters_later": [
        "date",
        "default"
      ],
      "blocks": {
        "title": {
          "fields": {
            "text": {
              "type": "string",
              "required": true
            }
          },
          "placeholders": [
            "text"
          ]
        },
        "text": {
          "fields": {
            "text": {
              "type": "string",
              "required": true
            }
          },
          "placeholders": [
            "text"
          ]
        },
        "badge": {
          "fields": {
            "text": {
              "type": "string",
              "required": true
            },
            "tone": {
              "type": "string",
              "required": false
            }
          },
          "placeholders": [
            "text"
          ]
        },
        "fields": {
          "fields": {
            "fields": {
              "type": "list",
              "required": true,
              "min": 1,
              "fields": {
                "label": {
                  "type": "string",
                  "required": true
                },
                "value": {
                  "type": "scalar",
                  "required": true
                }
              }
            }
          },
          "placeholders": [
            "fields.value"
          ],
          "plain_text": [
            "fields.label"
          ]
        },
        "code": {
          "fields": {
            "field": {
              "type": "string",
              "required": true
            },
            "language": {
              "type": "string",
              "required": false
            },
            "copy": {
              "type": "boolean",
              "required": false
            }
          },
          "names_fields": [
            "field"
          ],
          "needs_pin": [
            "copy"
          ]
        }
      },
      "blocks_later": [
        "rows",
        "steps",
        "spark",
        "actions",
        "html",
        "visual"
      ],
      "picking": {
        "list": {
          "off": {
            "option": "select",
            "values": [
              "none"
            ]
          }
        },
        "data-table": {
          "on": {
            "option": "plugins.select"
          }
        }
      },
      "table_like": {
        "data-table": {
          "records": "data",
          "column_option": "tooltip_field",
          "column_default": "tooltip",
          "needs_picking": true
        }
      },
      "pin": {
        "attributes": {
          "tip": "",
          "template": "-template",
          "record": "-record",
          "reason": "-reason",
          "pin": "-pin",
          "id": "-id",
          "kind": "-kind",
          "placement": "-placement"
        },
        "kind_default": "element",
        "kind_pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
        "refused": [
          "a[href]",
          "button[type=\"submit\"]",
          "button[type=\"reset\"]",
          "input",
          "select",
          "textarea",
          "summary",
          "label",
          "[contenteditable]:not([contenteditable=\"false\"])"
        ],
        "events": {
          "tip": {
            "state": {
              "type": "enum",
              "values": [
                "pinned",
                "closed"
              ]
            },
            "id": {
              "type": "id"
            },
            "kind": {
              "type": "string"
            },
            "ids": {
              "type": "json"
            },
            "reason": {
              "type": "enum",
              "values": [
                "select",
                "escape",
                "button",
                "outside",
                "replaced",
                "gone"
              ]
            },
            "text": {
              "type": "string"
            },
            "by": {
              "type": "enum",
              "values": [
                "reader",
                "data"
              ]
            },
            "from": {
              "type": "id"
            },
            "via": {
              "type": "enum",
              "values": [
                "click",
                "key"
              ]
            }
          },
          "copy": {
            "id": {
              "type": "id"
            },
            "kind": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "block": {
              "type": "integer"
            },
            "ok": {
              "type": "boolean"
            },
            "by": {
              "type": "enum",
              "values": [
                "reader"
              ]
            },
            "via": {
              "type": "enum",
              "values": [
                "click",
                "key"
              ]
            }
          }
        }
      }
    },
    "names": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "r_reserved": [
        "if",
        "else",
        "repeat",
        "while",
        "function",
        "for",
        "next",
        "break",
        "in"
      ]
    }
  }
}
