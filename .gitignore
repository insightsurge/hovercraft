# Session files
.Rproj.user/
.Rhistory
.RData

# Local secrets: tokens and passwords stay on your computer
.Renviron
.env
.env.*

# Operating system files
.DS_Store

# Local working notes, not shared
dev/

# Local maintainer files (the copy script is kept: its checks are versioned)
tools/*
!tools/copy-engine.R
!tools/check-release.R
!tools/make-figures.R

# Local tool settings stay out of git
.claude/settings.local.json
.claude/worktrees/
.codex/

# Local development libraries and startup files
renv/
renv.lock
.Rprofile

# Package build and check output
*.Rcheck/
hovercraft_*.tar.gz

# Generated site and temporary files
site/
.*.md.hold
/doc/
/Meta/
