{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "files": {
    "includes": [
      "inst/**/*.js",
      "inst/**/*.css",
      "tests/testthat/apps/testbench/www/**/*.js",
      "tests/testthat/apps/testbench/www/**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["inst/engine/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
